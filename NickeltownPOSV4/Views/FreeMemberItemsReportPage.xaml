<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="NickeltownPOSV4.Views.FreeMemberItemsReportPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:NickeltownPOSV4.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:NickeltownPOSV4.ViewModels"
    mc:Ignorable="d"
    Background="{StaticResource PosCanvasBrush}"
    NavigationCacheMode="Disabled">

    <Grid Padding="{StaticResource PosPagePadding}" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <controls:PosPageHero
            Grid.Row="0"
            IconGlyph="&#xE8B0;"
            Subtitle="Complimentary member items recorded from Member Tabs. Counts come from transactions. Retail value is informational only and is not revenue."
            Title="Free member items" />

        <Border Grid.Row="1" Style="{StaticResource SettingsCardStyle}">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Spacing="3">
                    <TextBlock Style="{StaticResource SettingsFieldLabelStyle}" Text="FROM" />
                    <Button Command="{Binding EditFromDateCommand}" Style="{StaticResource SettingsTapFieldStyle}">
                        <TextBlock Text="{Binding FromDateText, Mode=OneWay}" />
                    </Button>
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="3">
                    <TextBlock Style="{StaticResource SettingsFieldLabelStyle}" Text="THROUGH" />
                    <Button Command="{Binding EditToDateCommand}" Style="{StaticResource SettingsTapFieldStyle}">
                        <TextBlock Text="{Binding ToDateText, Mode=OneWay}" />
                    </Button>
                </StackPanel>
                <Button
                    Grid.Column="2"
                    MinHeight="44"
                    VerticalAlignment="Bottom"
                    Command="{Binding TodayCommand}"
                    Content="Today"
                    Style="{StaticResource SettingsSecondaryButtonStyle}" />
                <Button
                    Grid.Column="3"
                    MinHeight="44"
                    VerticalAlignment="Bottom"
                    Command="{Binding RefreshCommand}"
                    Content="Apply range"
                    Style="{StaticResource SettingsPrimaryButtonStyle}" />
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource SettingsCardStyle}">
            <Grid RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock
                    FontSize="13"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource PosTextPrimaryBrush}"
                    Text="FREE MEMBER ITEMS" />
                <ListView
                    Grid.Row="1"
                    IsItemClickEnabled="False"
                    ItemsSource="{Binding Lines, Mode=OneWay}"
                    SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:ComplimentaryReportLineViewModel">
                            <Grid Padding="0,8" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    FontSize="16"
                                    FontWeight="SemiBold"
                                    Text="{x:Bind ItemName, Mode=OneWay}" />
                                <TextBlock
                                    Grid.Column="1"
                                    FontSize="14"
                                    Text="{x:Bind PriceText, Mode=OneWay}" />
                                <TextBlock
                                    Grid.Column="2"
                                    MinWidth="90"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Text="{x:Bind RetailValueText, Mode=OneWay}"
                                    TextAlignment="Right" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <Grid Grid.Row="2" ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock FontSize="12" Foreground="{StaticResource PosTextSecondaryBrush}" Text="Total items" />
                        <TextBlock FontSize="22" FontWeight="Bold" Text="{Binding TotalItemsText, Mode=OneWay}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                        <TextBlock FontSize="12" Foreground="{StaticResource PosTextSecondaryBrush}" Text="Total retail value (informational)" />
                        <TextBlock
                            HorizontalAlignment="Right"
                            FontSize="22"
                            FontWeight="Bold"
                            Text="{Binding TotalRetailText, Mode=OneWay}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Row="3" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button
                Command="{Binding BackCommand}"
                Content="Back to reports"
                Style="{StaticResource SettingsSecondaryButtonStyle}" />
            <TextBlock
                Grid.Column="1"
                VerticalAlignment="Center"
                FontSize="12"
                Foreground="{StaticResource PosTextSecondaryBrush}"
                Text="{Binding StatusMessage, Mode=OneWay}"
                TextWrapping="WrapWholeWords" />
        </Grid>
    </Grid>
</Page>
