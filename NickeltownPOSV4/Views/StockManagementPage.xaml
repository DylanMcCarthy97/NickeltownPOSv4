<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="NickeltownPOSV4.Views.StockManagementPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:NickeltownPOSV4.Controls"
    xmlns:conv="using:NickeltownPOSV4.Converters"
    xmlns:vm="using:NickeltownPOSV4.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{StaticResource PosCanvasBrush}">
    <Page.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:ArgbStringToBrushConverter x:Key="ArgbBrush" />
        <conv:StockAlternateRowBrushConverter x:Key="StockAltRowBrush" />
        <Style x:Key="StockSegmentButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="UseSystemFocusVisuals" Value="False" />
        </Style>
        <Style x:Key="StockBottomBarButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="58" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Background" Value="#FFFDFEFF" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="BorderBrush" Value="{StaticResource PosBorderBrush}" />
            <Setter Property="UseSystemFocusVisuals" Value="False" />
            <Setter Property="Padding" Value="4,6" />
        </Style>
        <Style x:Key="StockListRowBorderStyle" TargetType="Border">
            <Setter Property="MinHeight" Value="64" />
            <Setter Property="MaxHeight" Value="68" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="BorderBrush" Value="{StaticResource PosBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </Page.Resources>
    <Grid x:Name="StockPageRoot">
        <!-- Stock v2 home: search → segments → list → bottom job bar (Toshiba 1024×768) -->
        <Grid
            x:Name="StockHomeRoot"
            Padding="10,6,10,8"
            Visibility="{Binding IsHomeScreen, Converter={StaticResource BoolToVis}, Mode=OneWay}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Search / scan first -->
            <Border
                Grid.Row="0"
                Background="{StaticResource PosSurfaceBrush}"
                BorderBrush="{StaticResource PosBorderBrush}"
                BorderThickness="1"
                CornerRadius="14"
                MinHeight="52">
                <Grid Padding="10,0" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon VerticalAlignment="Center" FontSize="18" Foreground="{StaticResource PosTextSecondaryBrush}" Glyph="&#xE721;" />
                    <TextBox
                        x:Name="StockSearchTextBox"
                        Grid.Column="1"
                        BorderThickness="0"
                        Background="Transparent"
                        GotFocus="StockSearchTextBox_GotFocus"
                        IsReadOnly="True"
                        PlaceholderText="Search or scan barcode"
                        Style="{StaticResource PosTouchFieldTextBoxStyle}"
                        Tapped="StockSearchTextBox_Tapped"
                        Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <Button
                        Grid.Column="2"
                        MinWidth="48"
                        MinHeight="48"
                        Click="StockScanBarcode_Click"
                        Style="{StaticResource TabsHeaderActionButtonStyle}"
                        ToolTipService.ToolTip="Scan barcode">
                        <FontIcon FontSize="18" Glyph="&#xE963;" />
                    </Button>
                    <Button
                        Grid.Column="3"
                        MinWidth="48"
                        MinHeight="48"
                        Click="AddItem_Click"
                        Style="{StaticResource TabsHeaderActionButtonStyle}"
                        ToolTipService.ToolTip="Add item">
                        <FontIcon FontSize="18" Glyph="&#xE710;" />
                    </Button>
                </Grid>
            </Border>

            <!-- Segmented filters -->
            <Border
                Grid.Row="1"
                Margin="0,8,0,0"
                Background="{StaticResource PosSurfaceBrush}"
                BorderBrush="{StaticResource PosBorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="4">
                <Grid ColumnSpacing="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ItemsControl
                        x:Name="FilterCardsItemsControl"
                        Grid.ColumnSpan="4"
                        ItemsSource="{Binding FilterCards, Mode=OneWay}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <controls:WrapChipPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button
                                    MinWidth="230"
                                    HorizontalAlignment="Stretch"
                                    Command="{Binding DataContext.SelectFilterCardCommand, ElementName=StockPageRoot}"
                                    CommandParameter="{Binding FilterIndex}"
                                    Style="{StaticResource StockSegmentButtonStyle}">
                                    <Border
                                        MinHeight="40"
                                        MinWidth="220"
                                        Margin="2"
                                        Background="{Binding ChipBackground, Converter={StaticResource ArgbBrush}, Mode=OneWay}"
                                        BorderBrush="{Binding ChipBorderBrush, Converter={StaticResource ArgbBrush}, Mode=OneWay}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="6,6">
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontSize="13"
                                            FontWeight="SemiBold"
                                            Foreground="{Binding ChipForeground, Converter={StaticResource ArgbBrush}, Mode=OneWay}"
                                            Text="{Binding CompactLabel, Mode=OneWay}"
                                            TextWrapping="NoWrap" />
                                    </Border>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>

            <!-- Slim product list -->
            <Border
                Grid.Row="2"
                Margin="0,8,0,0"
                Background="{StaticResource PosSurfaceBrush}"
                BorderBrush="{StaticResource PosBorderBrush}"
                BorderThickness="1"
                CornerRadius="14"
                Padding="3">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="10,6,10,4" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource PosTextSecondaryBrush}"
                            Text="{Binding ItemCountText, Mode=OneWay}" />
                        <Button
                            Grid.Column="1"
                            MinHeight="36"
                            MinWidth="88"
                            Click="RefreshStock_Click"
                            Content="Refresh"
                            CornerRadius="10"
                            Style="{StaticResource TabsHeaderActionButtonStyle}" />
                    </Grid>
                    <ListView
                        x:Name="ProductBrowserList"
                        Grid.Row="1"
                        IsItemClickEnabled="True"
                        ItemClick="ProductBrowserList_ItemClick"
                        ItemsSource="{Binding PageRows, Mode=OneWay}"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        ScrollViewer.HorizontalScrollMode="Disabled"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        SelectionMode="None">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0,2" />
                                <Setter Property="MinHeight" Value="64" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid HorizontalAlignment="Stretch">
                                    <Border
                                        HorizontalAlignment="Stretch"
                                        Background="{Binding IsAlternateRow, Converter={StaticResource StockAltRowBrush}}"
                                        Style="{StaticResource StockListRowBorderStyle}">
                                        <Grid Padding="12,8" ColumnSpacing="10" HorizontalAlignment="Stretch">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" MinWidth="0" />
                                                <ColumnDefinition Width="88" />
                                                <ColumnDefinition Width="118" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Spacing="1">
                                                <TextBlock
                                                    MaxLines="1"
                                                    FontSize="15"
                                                    FontWeight="SemiBold"
                                                    Foreground="{StaticResource PosTextPrimaryBrush}"
                                                    Text="{Binding Name, Mode=OneWay}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <TextBlock
                                                    MaxLines="1"
                                                    FontSize="12"
                                                    Foreground="{StaticResource PosTextSecondaryBrush}"
                                                    Text="{Binding CategoryLine, Mode=OneWay}"
                                                    TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <Grid
                                                Grid.Column="1"
                                                HorizontalAlignment="Stretch"
                                                VerticalAlignment="Center">
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    FontSize="26"
                                                    FontWeight="Bold"
                                                    Foreground="{StaticResource PosTextPrimaryBrush}"
                                                    Text="{Binding StockHeroText, Mode=OneWay}" />
                                                <Button
                                                    HorizontalAlignment="Stretch"
                                                    VerticalAlignment="Stretch"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Click="StockHeroAdjust_Click"
                                                    IsEnabled="{Binding CanQuickAdjustStock, Mode=OneWay}"
                                                    Tag="{Binding}"
                                                    Visibility="{Binding CanQuickAdjustStock, Converter={StaticResource BoolToVis}, Mode=OneWay}" />
                                            </Grid>
                                            <StackPanel
                                                Grid.Column="2"
                                                Orientation="Horizontal"
                                                Spacing="6"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding ShowStatusPill, Converter={StaticResource BoolToVis}, Mode=OneWay}">
                                                <Ellipse
                                                    Width="9"
                                                    Height="9"
                                                    VerticalAlignment="Center"
                                                    Fill="{Binding StatusAccentColor, Converter={StaticResource ArgbBrush}, Mode=OneWay}" />
                                                <TextBlock
                                                    MaxWidth="90"
                                                    MaxLines="1"
                                                    FontSize="12"
                                                    FontWeight="SemiBold"
                                                    Foreground="{Binding StatusAccentColor, Converter={StaticResource ArgbBrush}, Mode=OneWay}"
                                                    Text="{Binding StatusText, Mode=OneWay}"
                                                    TextTrimming="CharacterEllipsis"
                                                    VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <Border
                                        Background="#0F2563EB"
                                        BorderBrush="{StaticResource PosAccentBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        IsHitTestVisible="False"
                                        Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}, Mode=OneWay}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <!-- Bottom job bar -->
            <Grid Grid.Row="3" Margin="0,8,0,0" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button
                    Grid.Column="0"
                    Click="ShoppingList_Click"
                    Style="{StaticResource StockBottomBarButtonStyle}">
                    <StackPanel Spacing="2" HorizontalAlignment="Center">
                        <FontIcon FontSize="16" Foreground="{StaticResource PosWorkflowShoppingBrush}" Glyph="&#xE7BF;" />
                        <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource PosWorkflowShoppingBrush}" Text="Shopping" HorizontalAlignment="Center" />
                        <Border
                            MinWidth="18"
                            Padding="5,1"
                            HorizontalAlignment="Center"
                            Background="{StaticResource PosWorkflowShoppingBrush}"
                            CornerRadius="8"
                            Visibility="{Binding ShowNeedBuyingBadge, Converter={StaticResource BoolToVis}, Mode=OneWay}">
                            <TextBlock FontSize="10" FontWeight="Bold" Foreground="{StaticResource PosOnAccentForegroundBrush}" Text="{Binding NeedBuyingBadgeText, Mode=OneWay}" HorizontalAlignment="Center" />
                        </Border>
                    </StackPanel>
                </Button>
                <Button
                    Grid.Column="1"
                    Click="ReceiveStock_Click"
                    Style="{StaticResource StockBottomBarButtonStyle}">
                    <StackPanel Spacing="2" HorizontalAlignment="Center">
                        <FontIcon FontSize="16" Foreground="{StaticResource PosWorkflowReceiveBrush}" Glyph="&#xE8FB;" />
                        <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource PosWorkflowReceiveBrush}" Text="Receive" HorizontalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button
                    Grid.Column="2"
                    Click="CountStock_Click"
                    Style="{StaticResource StockBottomBarButtonStyle}">
                    <StackPanel Spacing="2" HorizontalAlignment="Center">
                        <FontIcon FontSize="16" Foreground="{StaticResource PosWorkflowCountBrush}" Glyph="&#xE8CB;" />
                        <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource PosWorkflowCountBrush}" Text="Count" HorizontalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button
                    Grid.Column="3"
                    Click="CatalogHealth_Click"
                    Style="{StaticResource StockBottomBarButtonStyle}">
                    <StackPanel Spacing="2" HorizontalAlignment="Center">
                        <FontIcon FontSize="16" Foreground="{StaticResource PosAccentBrush}" Glyph="&#xE9D9;" />
                        <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource PosAccentBrush}" Text="Health" HorizontalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button
                    Grid.Column="4"
                    MinWidth="64"
                    Click="StockMore_Click"
                    Style="{StaticResource StockBottomBarButtonStyle}">
                    <StackPanel Spacing="2" HorizontalAlignment="Center">
                        <FontIcon FontSize="16" Foreground="{StaticResource PosTextSecondaryBrush}" Glyph="&#xE712;" />
                        <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource PosTextSecondaryBrush}" Text="More" HorizontalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>

        <Grid
            x:Name="StockFullScreenHost"
            Padding="12,10,12,10"
            Visibility="{Binding IsFullScreenActive, Converter={StaticResource BoolToVis}, Mode=OneWay}">
            <ContentPresenter x:Name="StockFullScreenPresenter" />
        </Grid>
        <Grid x:Name="StockModalLayer" Canvas.ZIndex="5000" Visibility="Collapsed">
            <Border Background="#B3000000" Tapped="StockModalDim_Tapped" />
            <Border
                x:Name="StockModalCard"
                Margin="20"
                Padding="16,14"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                MaxWidth="920"
                MaxHeight="760"
                Background="{StaticResource PosSurfaceBrush}"
                BorderBrush="{StaticResource PosBorderBrush}"
                BorderThickness="1"
                CornerRadius="16">
                <Grid RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock
                        x:Name="StockModalTitleText"
                        Grid.Row="0"
                        FontSize="20"
                        FontWeight="Bold"
                        Foreground="{StaticResource PosTextPrimaryBrush}"
                        TextTrimming="CharacterEllipsis" />
                    <ScrollViewer
                        x:Name="StockModalScrollViewer"
                        Grid.Row="1"
                        Padding="0,0,0,12"
                        VerticalScrollBarVisibility="Visible">
                        <ContentPresenter x:Name="StockModalBodyPresenter" />
                    </ScrollViewer>
                    <Grid Grid.Row="2" ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button
                            x:Name="StockModalCloseButton"
                            Grid.Column="0"
                            MinHeight="50"
                            HorizontalAlignment="Stretch"
                            Click="StockModalCloseButton_Click"
                            Style="{StaticResource TabsHeaderActionButtonStyle}" />
                        <Button
                            x:Name="StockModalPrimaryButton"
                            Grid.Column="1"
                            MinHeight="50"
                            HorizontalAlignment="Stretch"
                            Click="StockModalPrimaryButton_Click"
                            Style="{StaticResource TabsHeaderActionButtonStyle}" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
