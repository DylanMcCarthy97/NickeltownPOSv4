<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="NickeltownPOSV4.Views.Settings.UpdateConfigPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:NickeltownPOSV4.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{StaticResource PosCanvasBrush}"
    NavigationCacheMode="Disabled">

    <Page.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
    </Page.Resources>

    <Grid Padding="14,12,14,12" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border
            x:Name="HeroBorder"
            Grid.Row="0"
            Padding="0"
            SizeChanged="OnHeroSizeChanged"
            Style="{StaticResource SettingsPageHeroStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ContentControl
                    x:Name="HeroChequerHost"
                    Grid.Row="0"
                    HorizontalAlignment="Left"
                    IsTabStop="False" />

                <StackPanel Grid.Row="1" Padding="22,16,22,18">
                    <TextBlock Style="{StaticResource SettingsHeroTitleStyle}" Text="Garage updates" />
                    <TextBlock
                        Margin="0,2,0,0"
                        Style="{StaticResource SettingsHeroSubtitleStyle}"
                        Text="The pit crew feed for this till — it checks for a new build, fits it, then restarts on its own." />
                    <TextBlock
                        Margin="0,10,0,0"
                        FontWeight="SemiBold"
                        Text="{Binding CurrentBuildText, Mode=OneWay}" />
                </StackPanel>
            </Grid>
        </Border>

        <TextBlock
            Grid.Row="1"
            FontSize="13"
            Foreground="{StaticResource PosTextSecondaryBrush}"
            Text="How it works: the till reads update-manifest.json on your feed, pulls in the new build, fits it, then restarts itself."
            TextWrapping="Wrap" />

        <Border Grid.Row="2" Style="{StaticResource SettingsCardStyle}">
            <StackPanel Spacing="12">
                <TextBlock Text="Update feed (folder, https://, or UNC)" />
                <TextBox
                    PlaceholderText="https://your-server/pos-updates  or  \\server\share\pos-updates"
                    Text="{Binding FeedBaseUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <CheckBox Content="Check for a new build when the app starts" IsChecked="{Binding CheckOnStartup, Mode=TwoWay}" />
                <CheckBox Content="Fit it without asking (kiosk mode)" IsChecked="{Binding AutoInstall, Mode=TwoWay}" />
                <TextBlock
                    FontSize="13"
                    Foreground="{StaticResource PosTextSecondaryBrush}"
                    Text="First-time setup: install once from the .msix. Later releases only need a new package and update-manifest.json on the feed. The till comes back on its own after a build — if it does not, open it from the Start menu once."
                    TextWrapping="Wrap" />
                <TextBlock
                    Foreground="#FFB91C1C"
                    Text="{Binding StatusMessage, Mode=OneWay}"
                    TextWrapping="Wrap"
                    Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVis}, Mode=OneWay}" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="3" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button
                Grid.Column="0"
                Command="{Binding CheckNowCommand}"
                Content="Check for new build"
                Style="{StaticResource SettingsPrimaryButtonStyle}" />
            <Button
                Grid.Column="1"
                Command="{Binding SaveCommand}"
                Content="Save"
                Style="{StaticResource SettingsPrimaryButtonStyle}" />
        </Grid>
    </Grid>
</Page>
