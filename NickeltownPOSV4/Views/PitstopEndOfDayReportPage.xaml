<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="NickeltownPOSV4.Views.PitstopEndOfDayReportPage"
    x:Name="RootReportPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:NickeltownPOSV4.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="{StaticResource PosCanvasBrush}"
    mc:Ignorable="d">
    <Page.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="EodPrimaryButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="52" />
            <Setter Property="MinWidth" Value="148" />
            <Setter Property="Padding" Value="18,12" />
            <Setter Property="Background" Value="{StaticResource PosAccentBrush}" />
            <Setter Property="Foreground" Value="#FFFFFFFF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="UseSystemFocusVisuals" Value="False" />
        </Style>

        <Style x:Key="EodSecondaryButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Background" Value="{StaticResource PosSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource PosBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource PosTextPrimaryBrush}" />
            <Setter Property="UseSystemFocusVisuals" Value="False" />
        </Style>

        <Style x:Key="EodValueButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="56" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Background" Value="#FFF8FAFC" />
            <Setter Property="BorderBrush" Value="{StaticResource PosBorderBrush}" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="Foreground" Value="{StaticResource PosTextPrimaryBrush}" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="UseSystemFocusVisuals" Value="False" />
        </Style>

        <Style x:Key="EodQtyButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="52" />
            <Setter Property="Height" Value="52" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="{StaticResource PosAccentBrush}" />
            <Setter Property="Foreground" Value="#FFFFFFFF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="UseSystemFocusVisuals" Value="False" />
        </Style>

        <Style x:Key="EodMetricLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource PosTextSecondaryBrush}" />
        </Style>

        <Style x:Key="EodMetricValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource PosTextPrimaryBrush}" />
        </Style>

        <Style x:Key="EodSectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource PosTextPrimaryBrush}" />
        </Style>

        <Style x:Key="EodHelpTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource PosTextSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="WrapWholeWords" />
        </Style>

        <Style x:Key="EodStageButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="#FFF3F5FA" />
            <Setter Property="Foreground" Value="#FF6B7280" />
            <Setter Property="UseSystemFocusVisuals" Value="False" />
        </Style>

        <Style x:Key="EodTillCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFF8FAFC" />
            <Setter Property="BorderBrush" Value="{StaticResource PosBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="12" />
        </Style>

        <DataTemplate x:Key="OutsideQtyRowTemplate">
            <Border
                Margin="0,4"
                Padding="10,8"
                Background="#FFF8FAFC"
                BorderBrush="{StaticResource PosBorderBrush}"
                BorderThickness="1"
                CornerRadius="12">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="72" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="15"
                        FontWeight="SemiBold"
                        Text="{Binding DisplayLabel, Mode=OneWay}"
                        TextWrapping="WrapWholeWords" />
                    <TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        FontSize="15"
                        Foreground="{StaticResource PosTextSecondaryBrush}"
                        Text="{Binding SuggestedPriceText, Mode=OneWay}" />
                    <Button
                        Grid.Column="2"
                        Command="{Binding DecrementQtyCommand}"
                        Content="−"
                        Style="{StaticResource EodQtyButtonStyle}" />
                    <Button
                        Grid.Column="3"
                        Command="{Binding BeginQtyCommand}"
                        Content="{Binding SoldQtyText, Mode=OneWay}"
                        Style="{StaticResource EodValueButtonStyle}"
                        MinHeight="52"
                        FontSize="20" />
                    <Button
                        Grid.Column="4"
                        Command="{Binding IncrementQtyCommand}"
                        Content="+"
                        Style="{StaticResource EodQtyButtonStyle}" />
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="12,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            Margin="0,0,0,8"
            Padding="14,10"
            Background="{StaticResource PosSurfaceBrush}"
            BorderBrush="{StaticResource PosBorderBrush}"
            BorderThickness="1"
            CornerRadius="16">
            <StackPanel Spacing="8">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button
                        MinWidth="88"
                        Click="Back_Click"
                        Content="Reports"
                        Style="{StaticResource EodSecondaryButtonStyle}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="0">
                        <TextBlock
                            FontSize="18"
                            FontWeight="SemiBold"
                            Text="Pitstop End of Day" />
                        <Button
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            Command="{Binding BeginReportDateCommand}"
                            HorizontalAlignment="Left"
                            HorizontalContentAlignment="Left">
                            <TextBlock
                                FontSize="13"
                                Foreground="{StaticResource PosTextSecondaryBrush}"
                                Text="{Binding HeaderSubtitle, Mode=OneWay}" />
                        </Button>
                    </StackPanel>
                    <Button
                        Grid.Column="2"
                        MinWidth="72"
                        Command="{Binding BeginEventNameCommand}"
                        Content="Edit"
                        Style="{StaticResource EodSecondaryButtonStyle}" />
                </Grid>

                <Grid ColumnSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="StageSales" Click="Stage_Click" Content="1  Sales" Style="{StaticResource EodStageButtonStyle}" Tag="0" />
                    <Button x:Name="StagePrizes" Grid.Column="1" Click="Stage_Click" Content="2  Prizes &amp; Expenses" Style="{StaticResource EodStageButtonStyle}" Tag="1" />
                    <Button x:Name="StageCount" Grid.Column="2" Click="Stage_Click" Content="3  Count &amp; Close" Style="{StaticResource EodStageButtonStyle}" Tag="2" />
                </Grid>

                <Border
                    Padding="10,8"
                    Background="#1A1D4ED8"
                    BorderBrush="#FF2563EB"
                    BorderThickness="1"
                    CornerRadius="10"
                    Visibility="{Binding IsTestModeBannerVisible, Converter={StaticResource BoolToVis}, Mode=OneWay}">
                    <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#FF2563EB" Text="{Binding TestModeBannerText, Mode=OneWay}" TextWrapping="WrapWholeWords" />
                </Border>
                <Border
                    Padding="10,8"
                    Background="#1A7F1D1D"
                    BorderBrush="#FFB91C1C"
                    BorderThickness="1"
                    CornerRadius="10"
                    Visibility="{Binding HasCardMismatch, Converter={StaticResource BoolToVis}, Mode=OneWay}">
                    <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#FFB91C1C" Text="{Binding MismatchBannerText, Mode=OneWay}" TextWrapping="WrapWholeWords" />
                </Border>
            </StackPanel>
        </Border>

        <ScrollViewer
            x:Name="MainScrollViewer"
            Grid.Row="1"
            VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="10" Padding="0,0,2,6">

                <!-- STEP 1 SALES -->
                <StackPanel x:Name="EodSectionSales" Spacing="10">
                    <Border Style="{StaticResource SettingsCardStyle}">
                        <StackPanel Spacing="10">
                            <Grid>
                                <TextBlock Style="{StaticResource EodSectionTitleStyle}" Text="Inside Pitstop sales" />
                                <Button
                                    HorizontalAlignment="Right"
                                    Command="{Binding ToggleInsideItemsCommand}"
                                    Content="{Binding InsideItemsToggleLabel, Mode=OneWay}"
                                    Style="{StaticResource EodSecondaryButtonStyle}" />
                            </Grid>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource EodTillCardStyle}">
                                    <StackPanel Spacing="2">
                                        <TextBlock Style="{StaticResource EodMetricLabelStyle}" Text="Cash sales" />
                                        <TextBlock FontSize="24" FontWeight="Bold" Text="{Binding PitstopCashText, Mode=OneWay}" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Style="{StaticResource EodTillCardStyle}">
                                    <StackPanel Spacing="2">
                                        <TextBlock Style="{StaticResource EodMetricLabelStyle}" Text="Card sales" />
                                        <TextBlock FontSize="24" FontWeight="Bold" Text="{Binding PitstopCardText, Mode=OneWay}" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Style="{StaticResource EodTillCardStyle}">
                                    <StackPanel Spacing="2">
                                        <TextBlock Style="{StaticResource EodMetricLabelStyle}" Text="Total sales" />
                                        <TextBlock FontSize="24" FontWeight="Bold" Foreground="{StaticResource PosAccentBrush}" Text="{Binding InsideTotalSalesText, Mode=OneWay}" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <ListView
                                MaxHeight="180"
                                ItemsSource="{Binding PitstopProductSales, Mode=OneWay}"
                                SelectionMode="None"
                                Visibility="{Binding ShowInsideItems, Converter={StaticResource BoolToVis}, Mode=OneWay}">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Padding="4,4" ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="56" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name}" TextWrapping="WrapWholeWords" />
                                            <TextBlock Grid.Column="1" HorizontalAlignment="Right" FontWeight="Bold" Text="{Binding Quantity}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SettingsCardStyle}">
                        <StackPanel Spacing="8">
                            <TextBlock Style="{StaticResource EodSectionTitleStyle}" Text="Outside merch / raffle" />
                            <ItemsControl ItemTemplate="{StaticResource OutsideQtyRowTemplate}" ItemsSource="{Binding MerchOutsideLines, Mode=OneWay}" />
                            <ItemsControl ItemTemplate="{StaticResource OutsideQtyRowTemplate}" ItemsSource="{Binding RaffleOutsideLines, Mode=OneWay}" />

                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource EodTillCardStyle}">
                                    <StackPanel Spacing="2">
                                        <TextBlock Style="{StaticResource EodMetricLabelStyle}" Text="Outside sales" />
                                        <TextBlock FontSize="20" FontWeight="Bold" Text="{Binding OutsideItemSalesText, Mode=OneWay}" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Style="{StaticResource EodTillCardStyle}">
                                    <StackPanel Spacing="2">
                                        <TextBlock Style="{StaticResource EodMetricLabelStyle}" Text="Card sales" />
                                        <TextBlock FontSize="20" FontWeight="Bold" Text="{Binding OutsideCardSalesText, Mode=OneWay}" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Style="{StaticResource EodTillCardStyle}">
                                    <StackPanel Spacing="2">
                                        <TextBlock Style="{StaticResource EodMetricLabelStyle}" Text="Cash sales" />
                                        <TextBlock FontSize="20" FontWeight="Bold" Text="{Binding OutsideCashSalesText, Mode=OneWay}" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <StackPanel
                                Orientation="Horizontal"
                                Spacing="16"
                                Visibility="{Binding HasOutsideSurcharge, Converter={StaticResource BoolToVis}, Mode=OneWay}">
                                <TextBlock Style="{StaticResource EodMetricLabelStyle}" Text="Card surcharge" />
                                <TextBlock FontWeight="SemiBold" Text="{Binding OutsideSurchargeText, Mode=OneWay}" />
                                <TextBlock Style="{StaticResource EodMetricLabelStyle}" Text="Square received" />
                                <TextBlock FontWeight="SemiBold" Text="{Binding OutsideSquareReceivedText, Mode=OneWay}" />
                            </StackPanel>

                            <Button
                                Command="{Binding BeginManualCombinedSquareCommand}"
                                Content="{Binding EnterCardManuallyLabel, Mode=OneWay}"
                                Style="{StaticResource EodSecondaryButtonStyle}"
                                Visibility="{Binding NeedsManualOutsideCard, Converter={StaticResource BoolToVis}, Mode=OneWay}" />

                            <Button
                                Command="{Binding ToggleAdvancedDetailsCommand}"
                                Content="{Binding ShowAdvancedDetailsLabel, Mode=OneWay}"
                                Style="{StaticResource EodSecondaryButtonStyle}" />

                            <StackPanel Spacing="8" Visibility="{Binding ShowAdvancedDetails, Converter={StaticResource BoolToVis}, Mode=OneWay}">
                                <TextBlock Style="{StaticResource EodHelpTextStyle}" Text="{Binding SquareReconciliationStatusText, Mode=OneWay}" />
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Command="{Binding SetSquareAutoModeCommand}" Content="Automatic Square" Style="{StaticResource EodSecondaryButtonStyle}" />
                                    <Button Grid.Column="1" Command="{Binding SetSquareManualModeCommand}" Content="Manual Square" Style="{StaticResource EodSecondaryButtonStyle}" />
                                    <Button Grid.Column="2" Command="{Binding RefreshSquareCommand}" Content="{Binding RefreshSquareButtonLabel, Mode=OneWay}" Style="{StaticResource EodSecondaryButtonStyle}" />
                                </Grid>
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Command="{Binding ShowPosSquareTransactionsCommand}" Content="{Binding PosSquareGrossText, Mode=OneWay}" Style="{StaticResource EodValueButtonStyle}" />
                                    <Button Grid.Column="1" Command="{Binding ShowOutsideSquareTransactionsCommand}" Content="{Binding OutsideSquareGrossText, Mode=OneWay}" Style="{StaticResource EodValueButtonStyle}" />
                                </Grid>
                                <Button Command="{Binding BeginSquareFeeCommand}" Content="{Binding SquareFeePercentText, Mode=OneWay}" Style="{StaticResource EodSecondaryButtonStyle}" />
                                <Button Command="{Binding ReloadOutsideLinesFromCatalogCommand}" Content="Reload outside catalogue" Style="{StaticResource EodSecondaryButtonStyle}" />
                                <Button Command="{Binding ToggleHideZeroOutsideLinesCommand}" Content="{Binding HideZeroOutsideLinesLabel, Mode=OneWay}" Style="{StaticResource EodSecondaryButtonStyle}" />
                                <Button
                                    Command="{Binding LoadTestReportCommand}"
                                    Content="Test data"
                                    Style="{StaticResource EodSecondaryButtonStyle}"
                                    Visibility="{Binding CanRunTestReport, Converter={StaticResource BoolToVis}, Mode=OneWay}" />
                                <Button
                                    Command="{Binding ClearTestReportCommand}"
                                    Content="Clear test"
                                    Style="{StaticResource EodSecondaryButtonStyle}"
                                    Visibility="{Binding IsTestModeBannerVisible, Converter={StaticResource BoolToVis}, Mode=OneWay}" />
                                <ItemsControl ItemsSource="{Binding ReconciliationWarnings, Mode=OneWay}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Margin="0,2,0,0" FontSize="12" Foreground="#FFB45309" Text="{Binding}" TextWrapping="WrapWholeWords" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- STEP 2 PRIZES -->
                <StackPanel x:Name="EodSectionPrizes" Spacing="10" Visibility="Collapsed">
                    <Border Style="{StaticResource SettingsCardStyle}">
                        <StackPanel Spacing="10">
                            <TextBlock Style="{StaticResource EodSectionTitleStyle}" Text="Prizes &amp; expenses" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Command="{Binding AddCashPrizeCommand}" Content="+ Cash prize" Style="{StaticResource EodPrimaryButtonStyle}" />
                                <Button Grid.Column="1" Command="{Binding AddStockPrizeCommand}" Content="+ Stock prize" Style="{StaticResource EodPrimaryButtonStyle}" />
                                <Button Grid.Column="2" Command="{Binding AddExpenseCommand}" Content="+ Expense" Style="{StaticResource EodPrimaryButtonStyle}" />
                            </Grid>

                            <ItemsControl ItemsSource="{Binding CashPrizes, Mode=OneWay}" Visibility="{Binding HasCashPrizes, Converter={StaticResource BoolToVis}, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,8" Style="{StaticResource EodTillCardStyle}">
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="110" />
                                                    <ColumnDefinition Width="120" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Button Command="{Binding BeginDescriptionCommand}" Content="{Binding Description, Mode=OneWay}" Style="{StaticResource EodSecondaryButtonStyle}" />
                                                <Button Grid.Column="1" Command="{Binding BeginAmountCommand}" Content="{Binding AmountText, Mode=OneWay}" Style="{StaticResource EodValueButtonStyle}" MinHeight="48" FontSize="18" />
                                                <Button Grid.Column="2" Command="{Binding CyclePaidFromCommand}" Content="{Binding PaidFromText, Mode=OneWay}" Style="{StaticResource EodSecondaryButtonStyle}" />
                                                <Button
                                                    Grid.Column="3"
                                                    MinWidth="48"
                                                    MinHeight="48"
                                                    Command="{Binding ElementName=RootReportPage, Path=DataContext.RemoveCashPrizeCommand}"
                                                    CommandParameter="{Binding}"
                                                    Content="✕"
                                                    Style="{StaticResource EodSecondaryButtonStyle}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <ItemsControl ItemsSource="{Binding Prizes, Mode=OneWay}" Visibility="{Binding HasStockPrizes, Converter={StaticResource BoolToVis}, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,8" Style="{StaticResource EodTillCardStyle}">
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="72" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock VerticalAlignment="Center" FontSize="15" Text="{Binding ItemName, Mode=OneWay}" TextWrapping="WrapWholeWords" />
                                                <Button Grid.Column="1" Command="{Binding DecrementQtyCommand}" Content="−" Style="{StaticResource EodQtyButtonStyle}" />
                                                <Button Grid.Column="2" Command="{Binding BeginQtyCommand}" Content="{Binding QuantityText, Mode=OneWay}" Style="{StaticResource EodValueButtonStyle}" MinHeight="52" />
                                                <Button Grid.Column="3" Command="{Binding IncrementQtyCommand}" Content="+" Style="{StaticResource EodQtyButtonStyle}" />
                                                <Button
                                                    Grid.Column="4"
                                                    MinWidth="48"
                                                    MinHeight="48"
                                                    Command="{Binding ElementName=RootReportPage, Path=DataContext.RemovePrizeCommand}"
                                                    CommandParameter="{Binding}"
                                                    Content="✕"
                                                    Style="{StaticResource EodSecondaryButtonStyle}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <ItemsControl ItemsSource="{Binding Expenses, Mode=OneWay}" Visibility="{Binding HasExpenses, Converter={StaticResource BoolToVis}, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,8" Style="{StaticResource EodTillCardStyle}">
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="110" />
                                                    <ColumnDefinition Width="140" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Button Command="{Binding BeginDescriptionCommand}" Content="{Binding Description, Mode=OneWay}" Style="{StaticResource EodSecondaryButtonStyle}" />
                                                <Button Grid.Column="1" Command="{Binding BeginAmountCommand}" Content="{Binding AmountText, Mode=OneWay}" Style="{StaticResource EodValueButtonStyle}" MinHeight="48" FontSize="18" />
                                                <Button
                                                    Grid.Column="2"
                                                    Command="{Binding CyclePaidFromCommand}"
                                                    Content="{Binding PaidFromText, Mode=OneWay}"
                                                    Style="{StaticResource EodSecondaryButtonStyle}"
                                                    Visibility="{Binding ElementName=RootReportPage, Path=DataContext.ShowAdvancedDetails, Converter={StaticResource BoolToVis}, Mode=OneWay}" />
                                                <TextBlock
                                                    Grid.Column="2"
                                                    VerticalAlignment="Center"
                                                    FontSize="13"
                                                    Foreground="{StaticResource PosTextSecondaryBrush}"
                                                    Text="Paid from bank"
                                                    Visibility="{Binding ElementName=RootReportPage, Path=DataContext.ShowAdvancedDetails, Converter={StaticResource BoolToVis}, ConverterParameter=Invert, Mode=OneWay}" />
                                                <Button
                                                    Grid.Column="3"
                                                    MinWidth="48"
                                                    MinHeight="48"
                                                    Command="{Binding ElementName=RootReportPage, Path=DataContext.RemoveExpenseCommand}"
                                                    CommandParameter="{Binding}"
                                                    Content="✕"
                                                    Style="{StaticResource EodSecondaryButtonStyle}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- STEP 3 COUNT -->
                <StackPanel x:Name="EodSectionCount" Spacing="10" Visibility="Collapsed">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel Spacing="8">
                                <TextBlock Style="{StaticResource EodSectionTitleStyle}" Text="Inside till" />
                                <TextBlock Style="{StaticResource EodMetricLabelStyle}" Text="Starting float" />
                                <Button Command="{Binding BeginInsideFloatCommand}" Content="{Binding InsideFloatText, Mode=OneWay}" Style="{StaticResource EodValueButtonStyle}" />
                                <Grid>
                                    <TextBlock Style="{StaticResource EodMetricLabelStyle}" Text="+ Cash sales" />
                                    <TextBlock HorizontalAlignment="Right" Text="{Binding InsideCashSalesText, Mode=OneWay}" />
                                </Grid>
                                <Grid>
                                    <TextBlock Style="{StaticResource EodMetricLabelStyle}" Text="− Cash prizes / till paid" />
                                    <TextBlock HorizontalAlignment="Right" Text="{Binding InsidePaidOutText, Mode=OneWay}" />
                                </Grid>
                                <Grid>
                                    <TextBlock FontWeight="SemiBold" Text="Expected cash" />
                                    <TextBlock HorizontalAlignment="Right" FontWeight="Bold" Text="{Binding ExpectedCashText, Mode=OneWay}" />
                                </Grid>
                                <Button Command="{Binding BeginCashCountedCommand}" Content="{Binding InsideCountedButtonText, Mode=OneWay}" Style="{StaticResource EodPrimaryButtonStyle}" />
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontSize="18"
                                    FontWeight="Bold"
                                    Foreground="{StaticResource PosBalanceGoodBrush}"
                                    Text="{Binding InsideVarianceStatusText, Mode=OneWay}"
                                    Visibility="{Binding InsideIsBalanced, Converter={StaticResource BoolToVis}, Mode=OneWay}" />
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontSize="18"
                                    FontWeight="Bold"
                                    Foreground="{StaticResource PosBalanceNegativeBrush}"
                                    Text="{Binding InsideVarianceStatusText, Mode=OneWay}"
                                    Visibility="{Binding HasInsideVariance, Converter={StaticResource BoolToVis}, Mode=OneWay}" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource SettingsCardStyle}">
                            <StackPanel Spacing="8">
                                <TextBlock Style="{StaticResource EodSectionTitleStyle}" Text="Outside tin" />
                                <TextBlock Style="{StaticResource EodMetricLabelStyle}" Text="Starting float" />
                                <Button Command="{Binding BeginOutsideFloatCommand}" Content="{Binding OutsideFloatText, Mode=OneWay}" Style="{StaticResource EodValueButtonStyle}" />
                                <Grid>
                                    <TextBlock Style="{StaticResource EodMetricLabelStyle}" Text="+ Cash sales" />
                                    <TextBlock HorizontalAlignment="Right" Text="{Binding OutsideCashSalesText, Mode=OneWay}" />
                                </Grid>
                                <Grid>
                                    <TextBlock Style="{StaticResource EodMetricLabelStyle}" Text="− Cash prizes / paid out" />
                                    <TextBlock HorizontalAlignment="Right" Text="{Binding OutsidePaidOutText, Mode=OneWay}" />
                                </Grid>
                                <Grid>
                                    <TextBlock FontWeight="SemiBold" Text="Expected cash" />
                                    <TextBlock HorizontalAlignment="Right" FontWeight="Bold" Text="{Binding OutsideExpectedCashText, Mode=OneWay}" />
                                </Grid>
                                <Button Command="{Binding BeginOutsideCashCountedCommand}" Content="{Binding OutsideCountedButtonText, Mode=OneWay}" Style="{StaticResource EodPrimaryButtonStyle}" />
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontSize="18"
                                    FontWeight="Bold"
                                    Foreground="{StaticResource PosBalanceGoodBrush}"
                                    Text="{Binding OutsideVarianceStatusText, Mode=OneWay}"
                                    Visibility="{Binding OutsideIsBalanced, Converter={StaticResource BoolToVis}, Mode=OneWay}" />
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontSize="18"
                                    FontWeight="Bold"
                                    Foreground="{StaticResource PosBalanceNegativeBrush}"
                                    Text="{Binding OutsideVarianceStatusText, Mode=OneWay}"
                                    Visibility="{Binding HasOutsideVariance, Converter={StaticResource BoolToVis}, Mode=OneWay}" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Button
                        Command="{Binding BeginArchiveNotesCommand}"
                        Content="Add note"
                        Style="{StaticResource EodSecondaryButtonStyle}"
                        Visibility="{Binding ShowInsideNoteAction, Converter={StaticResource BoolToVis}, Mode=OneWay}" />

                    <Border Style="{StaticResource SettingsCardStyle}">
                        <StackPanel Spacing="6">
                            <Grid>
                                <TextBlock FontSize="13" FontWeight="SemiBold" Text="TOTAL SALES" />
                                <TextBlock HorizontalAlignment="Right" FontSize="22" FontWeight="Bold" Text="{Binding GrossSalesText, Mode=OneWay}" />
                            </Grid>
                            <Grid>
                                <TextBlock Style="{StaticResource EodMetricLabelStyle}" Text="Cash sales" />
                                <TextBlock HorizontalAlignment="Right" Text="{Binding TotalCashSalesText, Mode=OneWay}" />
                            </Grid>
                            <Grid>
                                <TextBlock Style="{StaticResource EodMetricLabelStyle}" Text="Card sales" />
                                <TextBlock HorizontalAlignment="Right" Text="{Binding TotalCardSalesText, Mode=OneWay}" />
                            </Grid>
                            <Grid>
                                <TextBlock Style="{StaticResource EodMetricLabelStyle}" Text="Cash to bank" />
                                <TextBlock HorizontalAlignment="Right" FontWeight="Bold" Foreground="{StaticResource PosAccentBrush}" Text="{Binding CashToDepositText, Mode=OneWay}" />
                            </Grid>
                            <Grid>
                                <TextBlock Style="{StaticResource EodMetricLabelStyle}" Text="Expected Square deposit" />
                                <TextBlock HorizontalAlignment="Right" Text="{Binding ExpectedSquareDepositText, Mode=OneWay}" />
                            </Grid>
                            <Grid>
                                <TextBlock Style="{StaticResource EodMetricLabelStyle}" Text="Expenses" />
                                <TextBlock HorizontalAlignment="Right" Text="{Binding ExpensesText, Mode=OneWay}" />
                            </Grid>
                            <Grid>
                                <TextBlock Style="{StaticResource EodMetricLabelStyle}" Text="Cash prizes" />
                                <TextBlock HorizontalAlignment="Right" Text="{Binding CashPrizesText, Mode=OneWay}" />
                            </Grid>
                            <Grid>
                                <TextBlock Style="{StaticResource EodMetricLabelStyle}" Text="Known stock/product costs" />
                                <TextBlock HorizontalAlignment="Right" Text="{Binding KnownStockCostsText, Mode=OneWay}" />
                            </Grid>
                            <Grid>
                                <TextBlock Style="{StaticResource EodMetricLabelStyle}" Text="Square processing fees" />
                                <TextBlock HorizontalAlignment="Right" Text="{Binding SquareFeesText, Mode=OneWay}" />
                            </Grid>
                            <Grid Margin="0,4,0,0">
                                <TextBlock FontSize="15" FontWeight="Bold" Text="ESTIMATED PROFIT" />
                                <TextBlock HorizontalAlignment="Right" FontSize="22" FontWeight="Bold" Text="{Binding NetProfitText, Mode=OneWay}" />
                            </Grid>
                            <TextBlock
                                FontSize="12"
                                Foreground="{StaticResource PosTextSecondaryBrush}"
                                Text="{Binding UnknownStockCostsNote, Mode=OneWay}"
                                Visibility="{Binding HasUnknownStockCosts, Converter={StaticResource BoolToVis}, Mode=OneWay}" />
                            <TextBlock
                                FontSize="12"
                                Foreground="{StaticResource PosTextSecondaryBrush}"
                                Text="{Binding StatusMessage, Mode=OneWay}"
                                TextWrapping="WrapWholeWords"
                                Visibility="{Binding StatusMessage, Converter={StaticResource BoolToVis}, ConverterParameter=NotEmpty, Mode=OneWay}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <Border
            Grid.Row="2"
            Margin="0,8,0,0"
            Padding="12,10"
            Background="{StaticResource PosSurfaceBrush}"
            BorderBrush="{StaticResource PosBorderBrush}"
            BorderThickness="1"
            CornerRadius="16">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button
                    x:Name="WizardPreviousButton"
                    MinWidth="120"
                    Click="PreviousStep_Click"
                    Content="Back"
                    Style="{StaticResource EodSecondaryButtonStyle}" />
                <Button
                    x:Name="WizardNextButton"
                    Grid.Column="1"
                    Click="NextStep_Click"
                    Content="Next"
                    Style="{StaticResource EodPrimaryButtonStyle}" />
                <Button
                    x:Name="WizardSaveButton"
                    Grid.Column="1"
                    Command="{Binding ClosePitstopCommand}"
                    Content="CLOSE PITSTOP &amp; SAVE REPORT"
                    FontSize="14"
                    Style="{StaticResource EodPrimaryButtonStyle}"
                    Visibility="Collapsed" />
            </Grid>
        </Border>
    </Grid>
</Page>
