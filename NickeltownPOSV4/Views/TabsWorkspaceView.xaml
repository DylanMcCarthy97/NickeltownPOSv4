<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="NickeltownPOSV4.Views.TabsWorkspaceView"
    x:Name="TabsRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:NickeltownPOSV4.Controls"
    xmlns:converters="using:NickeltownPOSV4.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:panels="using:NickeltownPOSV4.Views.Panels"
    mc:Ignorable="d">

    <UserControl.Resources>
        <converters:BalanceTierToBrushConverter x:Key="BalanceTierToBrushConverter" />
        <converters:TabCardStripBrushConverter x:Key="TabCardStripBrushConverter" />
        <converters:TabSelectedBackgroundConverter x:Key="TabSelectedBackgroundConverter" />
        <converters:TabSelectedBorderBrushConverter x:Key="TabSelectedBorderBrushConverter" />
        <converters:TabSelectedBorderThicknessConverter x:Key="TabSelectedBorderThicknessConverter" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:TabsModeSegmentBrushConverter x:Key="ModeSegmentBg" />
        <converters:TabsModeSegmentForegroundConverter x:Key="ModeSegmentFg" />


        <!-- Scoped Pos* brushes (mutated for Bathurst; Normal syncs from Application theme). -->
        <SolidColorBrush x:Key="PosCanvasBrush" Color="#FFF3F5FA" />
        <SolidColorBrush x:Key="PosSurfaceBrush" Color="#FFFFFFFF" />
        <SolidColorBrush x:Key="PosSurfaceAltBrush" Color="#FFF8FAFF" />
        <SolidColorBrush x:Key="PosBorderBrush" Color="#1A0F172A" />
        <SolidColorBrush x:Key="PosAccentBrush" Color="#FF2563EB" />
        <SolidColorBrush x:Key="PosAccentMutedBrush" Color="#332563EB" />
        <SolidColorBrush x:Key="PosTextPrimaryBrush" Color="#FF0F172A" />
        <SolidColorBrush x:Key="PosTextSecondaryBrush" Color="#FF475569" />
        <SolidColorBrush x:Key="PosBalanceNegativeBrush" Color="#FFDC2626" />
        <SolidColorBrush x:Key="PosBalanceLowBrush" Color="#FFD97706" />
        <SolidColorBrush x:Key="PosBalanceGoodBrush" Color="#FF16A34A" />
        <SolidColorBrush x:Key="PosBalanceSettledBrush" Color="#FF64748B" />
        <SolidColorBrush x:Key="PosTabCardSelectedFill" Color="#FFEFF6FF" />
        <SolidColorBrush x:Key="PosSelectedCardBrush" Color="#FFEFF6FF" />
        <SolidColorBrush x:Key="PosSelectedCardBorderBrush" Color="#FF2563EB" />
        <SolidColorBrush x:Key="PosButtonPrimaryBrush" Color="#FF2563EB" />
        <SolidColorBrush x:Key="PosSuccessBrush" Color="#FF16A34A" />
        <SolidColorBrush x:Key="PosButtonSuccessBrush" Color="#FF16A34A" />
        <SolidColorBrush x:Key="PosButtonDangerBrush" Color="#FFDC2626" />
        <SolidColorBrush x:Key="PosButtonNeutralBrush" Color="#FF0F172A" />
        <SolidColorBrush x:Key="PosButtonDarkBrush" Color="#FF0F172A" />
        <SolidColorBrush x:Key="PosButtonSecondaryBrush" Color="#FF94A3B8" />
        <SolidColorBrush x:Key="PosOnAccentForegroundBrush" Color="#FFFFFFFF" />
        <SolidColorBrush x:Key="PosOnDarkForegroundBrush" Color="#FFFFFFFF" />
        <SolidColorBrush x:Key="PosOnDarkSecondaryForegroundBrush" Color="#FFCBD5E1" />
        <SolidColorBrush x:Key="PosGuestBrush" Color="#FFA855F7" />
        <SolidColorBrush x:Key="PosGuestMutedBrush" Color="#33A855F7" />
        <SolidColorBrush x:Key="PosScrimBrush" Color="#990F172A" />
        <SolidColorBrush x:Key="PosAddCardBorderBrush" Color="#662563EB" />
        <SolidColorBrush x:Key="PosAddGuestCardBorderBrush" Color="#66A855F7" />
        <SolidColorBrush x:Key="PosModeSegmentSelectedBrush" Color="#FF2563EB" />
        <SolidColorBrush x:Key="PosModeSegmentIdleBrush" Color="#FFFFFFFF" />
        <SolidColorBrush x:Key="PosHeaderBackgroundBrush" Color="#FF0F172A" />
        <SolidColorBrush x:Key="PosTabStripCreditBrush" Color="#FF16A34A" />
        <SolidColorBrush x:Key="PosTabStripOwingBrush" Color="#FFDC2626" />
        <SolidColorBrush x:Key="PosTabStripLowBrush" Color="#FFD97706" />
        <SolidColorBrush x:Key="PosTabStripSettledBrush" Color="#FF94A3B8" />
        <SolidColorBrush x:Key="PosTabStripGuestBrush" Color="#FFA855F7" />
        <SolidColorBrush x:Key="BathurstFreeItemBrush" Color="#FF2F6FED" />
        <SolidColorBrush x:Key="BathurstSelectedGlowBrush" Color="#66E32636" />

        <Style x:Key="TabsModeSegmentStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="50" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="UseSystemFocusVisuals" Value="False" />
            <Setter Property="Background" Value="{StaticResource PosModeSegmentIdleBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource PosBorderBrush}" />
            <Setter Property="Foreground" Value="{StaticResource PosTextPrimaryBrush}" />
        </Style>

        <Style x:Key="TabsSideActionButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="64" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="UseSystemFocusVisuals" Value="False" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="TabsSideActionWideStyle" TargetType="Button" BasedOn="{StaticResource TabsSideActionButtonStyle}">
            <Setter Property="MinHeight" Value="48" />
        </Style>

        <Style x:Key="TabsActionPrimaryStyle" TargetType="Button" BasedOn="{StaticResource TabsSideActionButtonStyle}">
            <Setter Property="Background" Value="{StaticResource PosButtonPrimaryBrush}" />
            <Setter Property="Foreground" Value="{StaticResource PosOnAccentForegroundBrush}" />
        </Style>

        <Style x:Key="TabsActionSuccessStyle" TargetType="Button" BasedOn="{StaticResource TabsSideActionButtonStyle}">
            <Setter Property="Background" Value="{StaticResource PosButtonSuccessBrush}" />
            <Setter Property="Foreground" Value="{StaticResource PosOnAccentForegroundBrush}" />
        </Style>

        <Style x:Key="TabsActionDarkStyle" TargetType="Button" BasedOn="{StaticResource TabsSideActionButtonStyle}">
            <Setter Property="Background" Value="{StaticResource PosButtonDarkBrush}" />
            <Setter Property="Foreground" Value="{StaticResource PosOnAccentForegroundBrush}" />
        </Style>

        <Style x:Key="TabsActionSecondaryStyle" TargetType="Button" BasedOn="{StaticResource TabsSideActionButtonStyle}">
            <Setter Property="Background" Value="{StaticResource PosButtonSecondaryBrush}" />
            <Setter Property="Foreground" Value="{StaticResource PosOnAccentForegroundBrush}" />
        </Style>

        <Style x:Key="TabsActionDangerStyle" TargetType="Button" BasedOn="{StaticResource TabsSideActionWideStyle}">
            <Setter Property="Background" Value="{StaticResource PosButtonDangerBrush}" />
            <Setter Property="Foreground" Value="{StaticResource PosOnAccentForegroundBrush}" />
        </Style>

        <Style x:Key="TabsActionGuestStyle" TargetType="Button" BasedOn="{StaticResource TabsSideActionButtonStyle}">
            <Setter Property="Background" Value="{StaticResource PosGuestBrush}" />
            <Setter Property="Foreground" Value="{StaticResource PosOnAccentForegroundBrush}" />
        </Style>

        <Style x:Key="QuickFreeItemTileStyle" TargetType="Button" BasedOn="{StaticResource TabsActionPrimaryStyle}">
            <Setter Property="MinHeight" Value="78" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="4,6" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="FontSize" Value="10" />
        </Style>

        <Style x:Key="TabsConfirmOverlayButtonStyle" TargetType="Button" BasedOn="{StaticResource TabsHeaderActionButtonStyle}">
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="TabsConfirmOverlayDangerButtonStyle" TargetType="Button" BasedOn="{StaticResource TabsConfirmOverlayButtonStyle}">
            <Setter Property="Background" Value="{StaticResource PosButtonDangerBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource PosButtonDangerBrush}" />
            <Setter Property="Foreground" Value="{StaticResource PosOnAccentForegroundBrush}" />
        </Style>
    </UserControl.Resources>

    <Grid x:Name="RootLayout" Background="{StaticResource PosCanvasBrush}">
        <Grid.RowDefinitions>
            <RowDefinition x:Name="HeaderRow" Height="56" />
            <RowDefinition x:Name="ModeRow" Height="70" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:PosWorkspaceHeader x:Name="NormalHeader" Grid.Row="0" Subtitle="Bar Tabs">
            <controls:PosWorkspaceHeader.RightContent>
                <Button
                    MinWidth="88"
                    MinHeight="44"
                    Padding="10,6"
                    Command="{Binding ToggleBathurstThemeCommand}"
                    Style="{StaticResource TabsPagerButtonDenseStyle}"
                    ToolTipService.ToolTip="Switch to Bathurst Race Day theme">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock FontWeight="SemiBold" Text="Normal" />
                        <TextBlock Opacity="0.7" Text="/" />
                        <TextBlock FontWeight="SemiBold" Opacity="0.7" Text="Bathurst" />
                    </StackPanel>
                </Button>
            </controls:PosWorkspaceHeader.RightContent>
        </controls:PosWorkspaceHeader>

        <!-- Bathurst Race Day header (88px): banner art + HTML-equivalent live text + theme toggle -->
        <Grid x:Name="BathurstHeader" Grid.Row="0" Height="88" Visibility="Collapsed">
            <Border Background="#FF101216" />
            <Image
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center"
                IsHitTestVisible="False"
                Source="ms-appx:///Assets/BathurstBanner1024x88.png"
                Stretch="UniformToFill" />
            <!-- Subtle carbon-fibre hint (static, no animation) -->
            <Border IsHitTestVisible="False" Opacity="0.18">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#00000000" Offset="0" />
                        <GradientStop Color="#33101016" Offset="0.5" />
                        <GradientStop Color="#00000000" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <Grid Padding="8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel
                    Grid.Column="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="1">
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="10"
                        FontWeight="SemiBold"
                        Foreground="#FFF5F5F5"
                        Text="NICKELTOWN POS" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="26"
                        FontWeight="Bold"
                        Foreground="#FFE32636"
                        Text="BATHURST 1000" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="9"
                        FontWeight="SemiBold"
                        Foreground="#FFB8BEC7"
                        Text="RACE DAY EDITION" />
                </StackPanel>
                <!-- 44×44 touch target; placed right so the 88px header stays within budget -->
                <Border
                    Grid.Column="2"
                    MinHeight="44"
                    MinWidth="168"
                    Padding="4"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Background="#CC101216"
                    BorderBrush="#66FFFFFF"
                    BorderThickness="1"
                    CornerRadius="22">
                    <Grid ColumnSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button
                            Grid.Column="0"
                            MinHeight="36"
                            MinWidth="72"
                            Padding="8,4"
                            Background="Transparent"
                            BorderThickness="0"
                            Command="{Binding ToggleBathurstThemeCommand}"
                            Foreground="#FFB8BEC7">
                            <TextBlock FontWeight="SemiBold" Text="Normal" />
                        </Button>
                        <Border
                            Grid.Column="1"
                            MinHeight="36"
                            MinWidth="72"
                            Background="#FFE32636"
                            CornerRadius="18">
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontWeight="Bold"
                                Foreground="White"
                                Text="Bathurst" />
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- Mode selector -->
        <Grid x:Name="ModeSelector" Grid.Row="1" Height="70" Margin="10,2,10,0" VerticalAlignment="Stretch">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button
                Grid.Column="0"
                HorizontalAlignment="Stretch"
                Background="{Binding BoardMode, Converter={StaticResource ModeSegmentBg}, ConverterParameter=Member, Mode=OneWay}"
                Command="{Binding SelectOpenTabsModeCommand}"
                MinHeight="{Binding ModeSegmentMinHeight, Mode=OneWay}"
                Foreground="{Binding BoardMode, Converter={StaticResource ModeSegmentFg}, ConverterParameter=Member, Mode=OneWay}"
                Style="{StaticResource TabsModeSegmentStyle}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="8,0,0,0">
                    <FontIcon Margin="0,0,6,0" FontFamily="Segoe MDL2 Assets" FontSize="16" Glyph="&#xE8FD;" />
                    <TextBlock FontWeight="SemiBold" Text="Member Tabs" />
                    <Border Margin="6,0,0,0" MinWidth="22" Padding="6,2" Background="{StaticResource PosAccentMutedBrush}" CornerRadius="10">
                        <TextBlock FontSize="12" FontWeight="Bold" Text="{Binding OpenTabsCount, Mode=OneWay}" />
                    </Border>
                </StackPanel>
            </Button>
            <Button
                Grid.Column="1"
                HorizontalAlignment="Stretch"
                Background="{Binding BoardMode, Converter={StaticResource ModeSegmentBg}, ConverterParameter=Guest, Mode=OneWay}"
                Command="{Binding SelectGuestTabsModeCommand}"
                MinHeight="{Binding ModeSegmentMinHeight, Mode=OneWay}"
                Foreground="{Binding BoardMode, Converter={StaticResource ModeSegmentFg}, ConverterParameter=Guest, Mode=OneWay}"
                Style="{StaticResource TabsModeSegmentStyle}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <FontIcon Margin="0,0,6,0" FontFamily="Segoe MDL2 Assets" FontSize="16" Glyph="&#xE716;" />
                    <TextBlock FontWeight="SemiBold" Text="Guest Tabs" />
                    <Border Margin="6,0,0,0" MinWidth="22" Padding="6,2" Background="{StaticResource PosGuestMutedBrush}" CornerRadius="10">
                        <TextBlock FontSize="12" FontWeight="Bold" Text="{Binding GuestTabsCount, Mode=OneWay}" />
                    </Border>
                </StackPanel>
            </Button>
            <Button
                Grid.Column="2"
                HorizontalAlignment="Stretch"
                Background="{Binding BoardMode, Converter={StaticResource ModeSegmentBg}, ConverterParameter=Archived, Mode=OneWay}"
                Command="{Binding SelectArchivedTabsModeCommand}"
                MinHeight="{Binding ModeSegmentMinHeight, Mode=OneWay}"
                Foreground="{Binding BoardMode, Converter={StaticResource ModeSegmentFg}, ConverterParameter=Archived, Mode=OneWay}"
                Style="{StaticResource TabsModeSegmentStyle}"
                Visibility="{Binding CanViewArchivedTabs, Converter={StaticResource BoolToVis}, Mode=OneWay}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,8,0">
                    <FontIcon Margin="0,0,6,0" FontFamily="Segoe MDL2 Assets" FontSize="16" Glyph="&#xE7B8;" />
                    <TextBlock FontWeight="SemiBold" Text="Archived Tabs" />
                    <Border Margin="6,0,0,0" MinWidth="22" Padding="6,2" Background="{StaticResource PosAccentMutedBrush}" CornerRadius="10">
                        <TextBlock FontSize="12" FontWeight="Bold" Text="{Binding ArchivedTabsCount, Mode=OneWay}" />
                    </Border>
                </StackPanel>
            </Button>
        </Grid>

        <!-- Main content: left 3x3 board + right selected tab panel -->
        <Grid x:Name="MainContent" Grid.Row="2" Margin="10,4,10,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftColumn" Width="7*" />
                <ColumnDefinition x:Name="GapColumn" Width="12" />
                <ColumnDefinition x:Name="RightColumn" Width="3*" />
            </Grid.ColumnDefinitions>

            <!-- Left tab board -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition x:Name="BoardFooterRow" Height="40" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Margin="0,0,0,4" Background="{StaticResource PosCanvasBrush}">
            <ItemsControl
                IsTabStop="False"
                ItemsSource="{Binding PageSlots, Mode=OneWay}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <controls:Uniform3x3Panel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="3" Tapped="BoardCell_Tapped">
                            <Border
                                Background="{StaticResource PosSurfaceAltBrush}"
                                BorderBrush="{StaticResource PosBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}, Mode=OneWay}" />

                            <Grid Visibility="{Binding IsAddCell, Converter={StaticResource BoolToVis}, Mode=OneWay}">
                                <Grid Visibility="{Binding IsNewMemberCell, Converter={StaticResource BoolToVis}, Mode=OneWay}">
                                    <Rectangle
                                        RadiusX="12"
                                        RadiusY="12"
                                        Fill="{StaticResource PosSurfaceAltBrush}"
                                        Stroke="{StaticResource PosAddCardBorderBrush}"
                                        StrokeDashArray="6,4"
                                        StrokeThickness="2" />
                                    <Border Padding="10" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <Border
                                                Width="48"
                                                Height="48"
                                                HorizontalAlignment="Center"
                                                Background="{StaticResource PosAccentMutedBrush}"
                                                CornerRadius="24">
                                                <FontIcon
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    FontFamily="Segoe MDL2 Assets"
                                                    FontSize="22"
                                                    Foreground="{StaticResource PosAccentBrush}"
                                                    Glyph="&#xE710;" />
                                            </Border>
                                            <TextBlock
                                                Margin="0,8,0,0"
                                                HorizontalAlignment="Center"
                                                FontSize="15"
                                                FontWeight="Bold"
                                                Foreground="{StaticResource PosAccentBrush}"
                                                Text="{Binding AddCardTitle, Mode=OneWay}" />
                                            <TextBlock
                                                Margin="0,4,0,0"
                                                MaxWidth="200"
                                                HorizontalAlignment="Center"
                                                FontSize="11"
                                                Foreground="{StaticResource PosTextSecondaryBrush}"
                                                Text="{Binding AddCardSubtitle, Mode=OneWay}"
                                                TextAlignment="Center"
                                                TextWrapping="WrapWholeWords" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                <Grid Visibility="{Binding IsNewGuestCell, Converter={StaticResource BoolToVis}, Mode=OneWay}">
                                    <Rectangle
                                        RadiusX="12"
                                        RadiusY="12"
                                        Fill="{StaticResource PosSurfaceAltBrush}"
                                        Stroke="{StaticResource PosAddGuestCardBorderBrush}"
                                        StrokeDashArray="6,4"
                                        StrokeThickness="2" />
                                    <Border Padding="10" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <Border
                                                Width="48"
                                                Height="48"
                                                HorizontalAlignment="Center"
                                                Background="{StaticResource PosGuestMutedBrush}"
                                                CornerRadius="24">
                                                <FontIcon
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    FontFamily="Segoe MDL2 Assets"
                                                    FontSize="22"
                                                    Foreground="{StaticResource PosGuestBrush}"
                                                    Glyph="&#xE710;" />
                                            </Border>
                                            <TextBlock
                                                Margin="0,8,0,0"
                                                HorizontalAlignment="Center"
                                                FontSize="15"
                                                FontWeight="Bold"
                                                Foreground="{StaticResource PosGuestBrush}"
                                                Text="{Binding AddCardTitle, Mode=OneWay}" />
                                            <TextBlock
                                                Margin="0,4,0,0"
                                                MaxWidth="200"
                                                HorizontalAlignment="Center"
                                                FontSize="11"
                                                Foreground="{StaticResource PosTextSecondaryBrush}"
                                                Text="{Binding AddCardSubtitle, Mode=OneWay}"
                                                TextAlignment="Center"
                                                TextWrapping="WrapWholeWords" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Grid>

                            <Border
                                Background="{Binding TabIsSelected, Converter={StaticResource TabSelectedBackgroundConverter}}"
                                BorderBrush="{Binding Converter={StaticResource TabSelectedBorderBrushConverter}, Mode=OneWay}"
                                BorderThickness="{Binding TabIsSelected, Converter={StaticResource TabSelectedBorderThicknessConverter}}"
                                CornerRadius="12"
                                Visibility="{Binding IsTabCell, Converter={StaticResource BoolToVis}, Mode=OneWay}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="4" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Border
                                        Grid.Row="0"
                                        Background="{Binding TabStripBrushSource, Converter={StaticResource TabCardStripBrushConverter}, Mode=OneWay}"
                                        CornerRadius="12,12,0,0" />
                                    <Grid Grid.Row="1" Padding="8,6,8,6">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock
                                            Grid.Row="0"
                                            MaxLines="2"
                                            LineHeight="20"
                                            HorizontalAlignment="Center"
                                            FontSize="{Binding DataContext.CardNameFontSize, ElementName=TabsRoot, Mode=OneWay}"
                                            FontWeight="SemiBold"
                                            Foreground="{StaticResource PosTextPrimaryBrush}"
                                            Text="{Binding TabDisplayName, Mode=OneWay}"
                                            TextAlignment="Center"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="WrapWholeWords" />
                                        <StackPanel
                                            Grid.Row="1"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Center"
                                            Spacing="2">
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                FontSize="{Binding DataContext.CardBalanceFontSize, ElementName=TabsRoot, Mode=OneWay}"
                                                FontWeight="Bold"
                                                Foreground="{Binding DisplayBalanceTier, Converter={StaticResource BalanceTierToBrushConverter}, Mode=OneWay}"
                                                Text="{Binding TabBalanceText, Mode=OneWay}"
                                                TextAlignment="Center" />
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                FontSize="{Binding DataContext.CardStatusFontSize, ElementName=TabsRoot, Mode=OneWay}"
                                                FontWeight="SemiBold"
                                                Foreground="{Binding DisplayBalanceTier, Converter={StaticResource BalanceTierToBrushConverter}, Mode=OneWay}"
                                                Text="{Binding TabStatusLabel, Mode=OneWay}"
                                                TextAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock
                                            Grid.Row="2"
                                            MaxLines="2"
                                            HorizontalAlignment="Center"
                                            FontSize="{Binding DataContext.CardFooterFontSize, ElementName=TabsRoot, Mode=OneWay}"
                                            Foreground="{StaticResource PosTextSecondaryBrush}"
                                            Text="{Binding TabFooterLine, Mode=OneWay}"
                                            TextAlignment="Center"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="WrapWholeWords" />
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
                </Border>

                <!-- Board footer: undo last transaction (confirm + PIN) + pagination -->
                <Grid x:Name="BoardFooter" Grid.Row="1" Height="40" VerticalAlignment="Top">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button
                        Grid.Column="0"
                        MinWidth="108"
                        Padding="10,4"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Command="{Binding UndoLastCommand}"
                        Style="{StaticResource TabsPagerButtonDenseStyle}"
                        ToolTipService.ToolTip="{Binding UndoToolTip, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontFamily="Segoe MDL2 Assets" FontSize="14" Glyph="&#xE7A7;" />
                            <TextBlock FontWeight="SemiBold" Text="Undo Last Transaction" />
                        </StackPanel>
                    </Button>
                    <controls:CatalogPagePager
                        Grid.Column="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        NextCommand="{Binding NextPageCommand}"
                        PageLabel="{Binding PageInfo, Mode=OneWay}"
                        PreviousCommand="{Binding PreviousPageCommand}" />
                </Grid>
            </Grid>

            <!-- Right selected tab panel -->
            <Border
                x:Name="RightPanel"
                Grid.Column="2"
                Padding="10,8"
                Background="{StaticResource PosSurfaceBrush}"
                BorderBrush="{StaticResource PosBorderBrush}"
                BorderThickness="1"
                CornerRadius="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel
                        Grid.Row="0"
                        Margin="0,0,0,8"
                        Spacing="4"
                        Visibility="{Binding ShowQuickFreeItems, Converter={StaticResource BoolToVis}, Mode=OneWay}">
                        <TextBlock
                            FontSize="10"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource PosAccentBrush}"
                            Text="FREE ITEMS" />
                        <ItemsRepeater ItemsSource="{Binding QuickFreeItems, Mode=OneWay}">
                            <ItemsRepeater.Layout>
                                <UniformGridLayout
                                    x:Name="FreeItemsLayout"
                                    ItemsJustification="Start"
                                    ItemsStretch="Fill"
                                    MinColumnSpacing="6"
                                    MinItemHeight="78"
                                    MinItemWidth="72"
                                    MinRowSpacing="6" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate>
                                    <Button
                                        HorizontalAlignment="Stretch"
                                        MinHeight="{Binding DataContext.FreeItemMinHeight, ElementName=TabsRoot, Mode=OneWay}"
                                        Command="{Binding RecordCommand}"
                                        CommandParameter="{Binding}"
                                        IsEnabled="{Binding CanRecord, Mode=OneWay}"
                                        Style="{StaticResource QuickFreeItemTileStyle}">
                                            <StackPanel HorizontalAlignment="Center" Spacing="2">
                                            <TextBlock
                                                FontSize="11"
                                                FontWeight="Bold"
                                                MaxLines="2"
                                                Text="{Binding TitleText, Mode=OneWay}"
                                                TextAlignment="Center"
                                                TextTrimming="CharacterEllipsis"
                                                TextWrapping="WrapWholeWords" />
                                            <TextBlock
                                                FontSize="9"
                                                Opacity="0.9"
                                                Text="{Binding TodayText, Mode=OneWay}"
                                                TextAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Spacing="4">
                        <TextBlock
                            FontSize="10"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource PosAccentBrush}"
                            Text="SELECTED TAB" />
                        <TextBlock
                            MaxLines="2"
                            FontSize="16"
                            FontWeight="Bold"
                            Foreground="{StaticResource PosTextPrimaryBrush}"
                            Text="{Binding SelectedTabName, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="WrapWholeWords"
                            Visibility="{Binding HasSelectedTab, Converter={StaticResource BoolToVis}, Mode=OneWay}" />
                        <TextBlock
                            FontSize="14"
                            Foreground="{StaticResource PosTextSecondaryBrush}"
                            Text="{Binding ActionBarPlaceholder, Mode=OneWay}"
                            TextWrapping="WrapWholeWords"
                            Visibility="{Binding HasSelectedTab, Converter={StaticResource BoolToVis}, ConverterParameter=Invert, Mode=OneWay}" />
                    </StackPanel>

                    <StackPanel
                        Grid.Row="2"
                        Margin="0,8,0,8"
                        Spacing="6"
                        Visibility="{Binding HasSelectedTab, Converter={StaticResource BoolToVis}, Mode=OneWay}">
                        <TextBlock
                            FontSize="10"
                            Foreground="{StaticResource PosTextSecondaryBrush}"
                            Text="CURRENT BALANCE" />
                        <TextBlock
                            FontSize="28"
                            FontWeight="Bold"
                            Foreground="{Binding SelectedBalanceTier, Converter={StaticResource BalanceTierToBrushConverter}, Mode=OneWay}"
                            Text="{Binding SelectedBalanceText, Mode=OneWay}" />
                        <TextBlock
                            FontSize="11"
                            FontWeight="SemiBold"
                            Foreground="{Binding SelectedBalanceTier, Converter={StaticResource BalanceTierToBrushConverter}, Mode=OneWay}"
                            Text="{Binding SelectedStatusLabel, Mode=OneWay}" />
                        <StackPanel Margin="0,4,0,0" Spacing="2">
                            <TextBlock FontSize="9" Foreground="{StaticResource PosTextSecondaryBrush}" Text="LAST UPDATED" />
                            <TextBlock
                                FontSize="11"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource PosTextPrimaryBrush}"
                                Text="{Binding SelectedLastUpdated, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Spacing="2">
                            <TextBlock FontSize="9" Foreground="{StaticResource PosTextSecondaryBrush}" Text="LAST ACTIVITY" />
                            <TextBlock
                                FontSize="11"
                                Foreground="{StaticResource PosTextPrimaryBrush}"
                                Text="{Binding SelectedDrinksLine, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="WrapWholeWords"
                                MaxLines="3" />
                        </StackPanel>
                    </StackPanel>

                    <Grid Grid.Row="3">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid
                            x:Name="MemberActionsGrid"
                            Grid.Row="0"
                            ColumnSpacing="6"
                            RowSpacing="6"
                            Visibility="{Binding ShowMemberTabActions, Converter={StaticResource BoolToVis}, Mode=OneWay}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Button
                                Grid.Row="0"
                                Grid.Column="0"
                                Command="{Binding OpenDrinksPanelCommand}"
                                MinHeight="{Binding SideActionMinHeight, Mode=OneWay}"
                                Style="{StaticResource TabsActionPrimaryStyle}">
                                <StackPanel HorizontalAlignment="Center" Spacing="3">
                                    <Image Width="22" Height="22">
                                        <Image.Source>
                                            <SvgImageSource UriSource="ms-appx:///Assets/BeerMugIcon.svg" />
                                        </Image.Source>
                                    </Image>
                                    <TextBlock Text="Add Drinks" TextAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button
                                Grid.Row="0"
                                Grid.Column="1"
                                Command="{Binding OpenFundsPanelCommand}"
                                MinHeight="{Binding SideActionMinHeight, Mode=OneWay}"
                                Style="{StaticResource TabsActionSuccessStyle}">
                                <StackPanel HorizontalAlignment="Center" Spacing="3">
                                    <FontIcon FontFamily="Segoe MDL2 Assets" FontSize="18" Glyph="&#xE8C7;" />
                                    <TextBlock Text="Add Funds" TextAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button
                                Grid.Row="1"
                                Grid.Column="0"
                                Command="{Binding OpenTabHistoryPanelCommand}"
                                MinHeight="{Binding SideActionMinHeight, Mode=OneWay}"
                                Style="{StaticResource TabsActionDarkStyle}">
                                <StackPanel HorizontalAlignment="Center" Spacing="3">
                                    <FontIcon FontFamily="Segoe MDL2 Assets" FontSize="18" Glyph="&#xE8A1;" />
                                    <TextBlock Text="History" TextAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button
                                Grid.Row="1"
                                Grid.Column="1"
                                Command="{Binding EditTabCommand}"
                                MinHeight="{Binding SideActionMinHeight, Mode=OneWay}"
                                Style="{StaticResource TabsActionSecondaryStyle}">
                                <StackPanel HorizontalAlignment="Center" Spacing="3">
                                    <FontIcon FontFamily="Segoe MDL2 Assets" FontSize="18" Glyph="&#xE70F;" />
                                    <TextBlock Text="Edit Tab" TextAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button
                                Grid.Row="2"
                                Grid.Column="0"
                                Grid.ColumnSpan="2"
                                Margin="0,0,0,0"
                                Command="{Binding ArchiveSelectedCommand}"
                                MinHeight="{Binding SideActionMinHeight, Mode=OneWay}"
                                Style="{StaticResource TabsActionDangerStyle}"
                                Visibility="{Binding CanAdminArchiveTab, Converter={StaticResource BoolToVis}, Mode=OneWay}">
                                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Spacing="6">
                                    <FontIcon FontFamily="Segoe MDL2 Assets" FontSize="16" Glyph="&#xE7B8;" />
                                    <TextBlock Text="Archive Tab" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <Grid
                            Grid.Row="0"
                            ColumnSpacing="6"
                            RowSpacing="6"
                            Visibility="{Binding ShowGuestTabActions, Converter={StaticResource BoolToVis}, Mode=OneWay}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Button
                                Grid.Row="0"
                                Grid.Column="0"
                                Command="{Binding OpenDrinksPanelCommand}"
                                MinHeight="{Binding SideActionMinHeight, Mode=OneWay}"
                                Style="{StaticResource TabsActionPrimaryStyle}">
                                <StackPanel HorizontalAlignment="Center" Spacing="3">
                                    <Image Width="22" Height="22">
                                        <Image.Source>
                                            <SvgImageSource UriSource="ms-appx:///Assets/BeerMugIcon.svg" />
                                        </Image.Source>
                                    </Image>
                                    <TextBlock Text="Add Drinks" TextAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button
                                Grid.Row="0"
                                Grid.Column="1"
                                Command="{Binding CloseOutGuestTabCommand}"
                                MinHeight="{Binding SideActionMinHeight, Mode=OneWay}"
                                Style="{StaticResource TabsActionGuestStyle}">
                                <StackPanel HorizontalAlignment="Center" Spacing="3">
                                    <FontIcon FontFamily="Segoe MDL2 Assets" FontSize="18" Glyph="&#xE8C8;" />
                                    <TextBlock Text="Close Out" TextAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button
                                Grid.Row="1"
                                Grid.Column="0"
                                Grid.ColumnSpan="2"
                                Command="{Binding EditTabCommand}"
                                MinHeight="{Binding SideActionMinHeight, Mode=OneWay}"
                                Style="{StaticResource TabsActionSecondaryStyle}">
                                <StackPanel HorizontalAlignment="Center" Spacing="3">
                                    <FontIcon FontFamily="Segoe MDL2 Assets" FontSize="18" Glyph="&#xE70F;" />
                                    <TextBlock Text="Edit Tab" TextAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <Button
                            Grid.Row="1"
                            Margin="0,6,0,0"
                            Command="{Binding RestoreSelectedCommand}"
                            IsEnabled="{Binding HasSelectedTab, Mode=OneWay}"
                            MinHeight="{Binding SideActionMinHeight, Mode=OneWay}"
                                Style="{StaticResource TabsActionSuccessStyle}"
                            Visibility="{Binding IsArchivedMode, Converter={StaticResource BoolToVis}, Mode=OneWay}">
                            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Spacing="6">
                                <FontIcon FontFamily="Segoe MDL2 Assets" FontSize="16" Glyph="&#xE777;" />
                                <TextBlock Text="Restore Tab" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Grid
            Grid.RowSpan="3"
            Padding="0,0,0,16"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Canvas.ZIndex="20"
            Visibility="{Binding FreeItemToastVisible, Converter={StaticResource BoolToVis}, Mode=OneWay}">
            <Border
                MinWidth="280"
                MaxWidth="460"
                Padding="12,10"
                Background="{StaticResource PosButtonSuccessBrush}"
                CornerRadius="12">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource PosOnAccentForegroundBrush}"
                        Text="{Binding FreeItemToastMessage, Mode=OneWay}"
                        TextWrapping="WrapWholeWords" />
                    <Button
                        Grid.Column="1"
                        MinHeight="40"
                        MinWidth="84"
                        Padding="10,4"
                        VerticalAlignment="Center"
                        Command="{Binding UndoComplimentaryToastCommand}"
                        Content="UNDO"
                        FontWeight="Bold"
                        Visibility="{Binding FreeItemToastCanUndo, Converter={StaticResource BoolToVis}, Mode=OneWay}" />
                </Grid>
            </Border>
        </Grid>

        <Grid
            Grid.RowSpan="3"
            Background="{StaticResource PosScrimBrush}"
            Visibility="{Binding ArchiveOverlayVisible, Converter={StaticResource BoolToVis}, Mode=OneWay}">
            <Border
                Width="380"
                Padding="14"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{StaticResource PosSurfaceBrush}"
                BorderBrush="{StaticResource PosBorderBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        FontSize="15"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource PosTextPrimaryBrush}"
                        Text="Archive tab?"
                        TextWrapping="WrapWholeWords" />
                    <TextBlock
                        Margin="0,8,0,0"
                        FontSize="13"
                        Foreground="{StaticResource PosTextSecondaryBrush}"
                        Text="{Binding ArchiveOverlayText, Mode=OneWay}"
                        TextWrapping="WrapWholeWords" />
                    <Grid Margin="0,14,0,0" ColumnDefinitions="*,10,*">
                        <Button
                            Grid.Column="0"
                            Command="{Binding CancelArchiveCommand}"
                            Content="Cancel"
                            Style="{StaticResource TabsConfirmOverlayButtonStyle}" />
                        <Button
                            Grid.Column="2"
                            Command="{Binding ConfirmArchiveCommand}"
                            Content="Archive"
                            Style="{StaticResource TabsConfirmOverlayButtonStyle}" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <Grid
            Grid.RowSpan="3"
            Background="{StaticResource PosScrimBrush}"
            Visibility="{Binding DeleteOverlayVisible, Converter={StaticResource BoolToVis}, Mode=OneWay}">
            <Border
                Width="400"
                Padding="14"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{StaticResource PosSurfaceBrush}"
                BorderBrush="{StaticResource PosBorderBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        FontSize="15"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource PosTextPrimaryBrush}"
                        Text="Delete tab permanently?"
                        TextWrapping="WrapWholeWords" />
                    <TextBlock
                        Margin="0,8,0,0"
                        FontSize="13"
                        Foreground="{StaticResource PosTextSecondaryBrush}"
                        Text="{Binding DeleteOverlayText, Mode=OneWay}"
                        TextWrapping="WrapWholeWords" />
                    <Grid Margin="0,14,0,0" ColumnDefinitions="*,10,*">
                        <Button
                            Grid.Column="0"
                            Command="{Binding CancelDeleteCommand}"
                            Content="Cancel"
                            Style="{StaticResource TabsConfirmOverlayButtonStyle}" />
                        <Button
                            Grid.Column="2"
                            Command="{Binding ConfirmPermanentDeleteCommand}"
                            Content="Delete"
                            Style="{StaticResource TabsConfirmOverlayDangerButtonStyle}" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <Grid
            Grid.RowSpan="3"
            Background="{StaticResource PosCanvasBrush}"
            Visibility="{Binding IsAddDrinksWorkspaceOpen, Converter={StaticResource BoolToVis}, Mode=OneWay}"
            Canvas.ZIndex="25">
            <panels:AddDrinksPanel DataContext="{Binding CurrentAddDrinksViewModel, Mode=OneWay}" />
        </Grid>
    </Grid>
</UserControl>
