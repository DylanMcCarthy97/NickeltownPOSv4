<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="NickeltownPOSV4.Controls.BathurstTabsHeader"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:NickeltownPOSV4.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Height="88"
    MinHeight="88"
    MaxHeight="88">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid Background="#FF101216">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="156" />
        </Grid.ColumnDefinitions>

        <!-- Artwork region (~868px of 1024): cars + quiet centre for live title -->
        <Grid Grid.Column="0" Height="88">
            <Image
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center"
                Height="88"
                IsHitTestVisible="False"
                Stretch="UniformToFill">
                <Image.Source>
                    <BitmapImage UriSource="ms-appx:///Assets/Bathurst/BathurstBanner1024x88.png" DecodePixelWidth="1024" DecodePixelHeight="88" />
                </Image.Source>
            </Image>
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="1">
                <TextBlock
                    HorizontalAlignment="Center"
                    FontSize="10"
                    FontWeight="SemiBold"
                    Foreground="#FFF5F5F5"
                    Text="NICKELTOWN POS" />
                <TextBlock
                    HorizontalAlignment="Center"
                    FontSize="32"
                    FontStyle="Italic"
                    FontWeight="Bold"
                    Foreground="#FFE32636"
                    Text="BATHURST 1000" />
                <TextBlock
                    HorizontalAlignment="Center"
                    FontSize="9"
                    FontWeight="SemiBold"
                    Foreground="#FFB8BEC7"
                    Text="RACE DAY EDITION" />
            </StackPanel>
        </Grid>

        <!-- Control region 156px: Normal / Bathurst (admins only) -->
        <Border
            Grid.Column="1"
            MinHeight="44"
            MinWidth="148"
            Margin="4,0,8,0"
            Padding="4"
            VerticalAlignment="Center"
            Background="#CC101216"
            BorderBrush="#66FFFFFF"
            BorderThickness="1"
            CornerRadius="22"
            Visibility="{Binding CanToggleBathurstTheme, Converter={StaticResource BoolToVis}, Mode=OneWay}">
            <Grid ColumnSpacing="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button
                    Grid.Column="0"
                    MinHeight="36"
                    MinWidth="68"
                    Padding="6,4"
                    HorizontalAlignment="Stretch"
                    Background="Transparent"
                    BorderThickness="0"
                    Command="{Binding SetBathurstThemeCommand}"
                    CommandParameter="False"
                    Foreground="#FFB8BEC7">
                    <TextBlock FontWeight="SemiBold" Text="Normal" />
                </Button>
                <Border
                    Grid.Column="1"
                    MinHeight="36"
                    MinWidth="68"
                    Background="#FFE32636"
                    CornerRadius="18">
                    <Button
                        MinHeight="36"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Background="Transparent"
                        BorderThickness="0"
                        Command="{Binding SetBathurstThemeCommand}"
                        CommandParameter="True"
                        Foreground="White">
                        <TextBlock FontWeight="Bold" Text="Bathurst" />
                    </Button>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
