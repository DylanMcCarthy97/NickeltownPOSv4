<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="NickeltownPOSV4.Controls.BathurstTabsHeader"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Height="112"
    MinHeight="112"
    MaxHeight="112">

    <!--
      Full-width Race Day banner (112px).
      Artwork is a single continuous photo (exactly two cars).
      Titles, circuit outline and slogan are live overlays.
    -->
    <Grid Background="#FF101216">
        <Image
            HorizontalAlignment="Stretch"
            VerticalAlignment="Center"
            Height="112"
            IsHitTestVisible="False"
            Stretch="Uniform">
            <Image.Source>
                <BitmapImage
                    DecodePixelWidth="1024"
                    UriSource="ms-appx:///Assets/Bathurst/BathurstBanner1024x112.png" />
            </Image.Source>
        </Image>

        <Image
            Width="56"
            Height="112"
            HorizontalAlignment="Left"
            IsHitTestVisible="False"
            Opacity="0.38"
            Stretch="Fill">
            <Image.Source>
                <BitmapImage UriSource="ms-appx:///Assets/Bathurst/chequered-edge.png" />
            </Image.Source>
        </Image>

        <Grid
            Margin="12,6,0,8"
            HorizontalAlignment="Left"
            VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Image
                Grid.Column="0"
                Width="110"
                Height="78"
                Margin="0,2,10,0"
                VerticalAlignment="Center"
                IsHitTestVisible="False"
                Stretch="Uniform">
                <Image.Source>
                    <BitmapImage
                        DecodePixelWidth="220"
                        UriSource="ms-appx:///Assets/Bathurst/mount-panorama-outline.png" />
                </Image.Source>
            </Image>

            <StackPanel
                Grid.Column="1"
                VerticalAlignment="Center"
                Spacing="-2">
                <TextBlock
                    FontSize="10"
                    FontWeight="SemiBold"
                    Foreground="#FFF5F5F5"
                    Opacity="0.92"
                    CharacterSpacing="40"
                    Text="NICKELTOWN POS" />
                <TextBlock
                    Margin="0,-1,0,0"
                    FontSize="30"
                    FontStyle="Italic"
                    FontWeight="Bold"
                    Foreground="#FFFFFFFF"
                    CharacterSpacing="-20"
                    Text="BATHURST" />
                <TextBlock
                    Margin="2,-6,0,0"
                    FontSize="42"
                    FontStyle="Italic"
                    FontWeight="Bold"
                    Foreground="#FFE32636"
                    CharacterSpacing="-40"
                    Text="1000" />
            </StackPanel>
        </Grid>

        <StackPanel
            Margin="0,0,18,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Spacing="-2">
            <TextBlock
                HorizontalAlignment="Right"
                FontSize="13"
                FontStyle="Italic"
                FontWeight="Bold"
                Foreground="#FFFFFFFF"
                CharacterSpacing="40"
                Text="GREATEST RACE" />
            <TextBlock
                HorizontalAlignment="Right"
                FontSize="19"
                FontStyle="Italic"
                FontWeight="Bold"
                Foreground="#FFE32636"
                CharacterSpacing="60"
                Text="ON EARTH" />
        </StackPanel>

        <Border
            Height="2"
            VerticalAlignment="Bottom"
            Background="#FFE32636"
            IsHitTestVisible="False" />
    </Grid>
</UserControl>
