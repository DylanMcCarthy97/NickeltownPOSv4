<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="NickeltownPOSV4.Controls.BathurstTabsHeader"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Height="112"
    MinHeight="112"
    MaxHeight="112">

    <!--
      Full-width Race Day banner (112px).
      Artwork is a single continuous photo (exactly two cars).
      Titles, circuit outline and slogan are live overlays.
    -->
    <Grid Background="#FF101216">
        <Image
            HorizontalAlignment="Stretch"
            VerticalAlignment="Center"
            Height="112"
            IsHitTestVisible="False"
            Stretch="Uniform">
            <Image.Source>
                <BitmapImage
                    DecodePixelWidth="1024"
                    UriSource="ms-appx:///Assets/Bathurst/BathurstBanner1024x112.png" />
            </Image.Source>
        </Image>

        <Image
            Width="48"
            Height="112"
            HorizontalAlignment="Left"
            IsHitTestVisible="False"
            Opacity="0.35"
            Stretch="Fill">
            <Image.Source>
                <BitmapImage UriSource="ms-appx:///Assets/Bathurst/chequered-edge.png" />
            </Image.Source>
        </Image>

        <!-- Left title block: room for italic overhang so the final T is not clipped -->
        <Grid
            Margin="10,4,0,6"
            HorizontalAlignment="Left"
            VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Image
                Grid.Column="0"
                Width="92"
                Height="70"
                Margin="0,4,8,0"
                VerticalAlignment="Center"
                IsHitTestVisible="False"
                Stretch="Uniform">
                <Image.Source>
                    <BitmapImage
                        DecodePixelWidth="184"
                        UriSource="ms-appx:///Assets/Bathurst/mount-panorama-outline.png" />
                </Image.Source>
            </Image>

            <StackPanel
                Grid.Column="1"
                Margin="0,0,20,0"
                VerticalAlignment="Center"
                Spacing="0">
                <TextBlock
                    FontSize="10"
                    FontWeight="SemiBold"
                    Foreground="#FFF5F5F5"
                    Opacity="0.92"
                    CharacterSpacing="40"
                    Text="NICKELTOWN POS" />
                <!-- Trailing spaces + padding reserve italic overhang so the final T is not clipped. -->
                <TextBlock
                    Margin="0,0,0,0"
                    Padding="0,2,22,2"
                    FontSize="28"
                    FontStyle="Italic"
                    FontWeight="Bold"
                    Foreground="#FFFFFFFF"
                    Text="BATHURST  "
                    TextTrimming="None"
                    TextWrapping="NoWrap" />
                <TextBlock
                    Margin="2,-4,0,0"
                    Padding="0,0,22,2"
                    FontSize="38"
                    FontStyle="Italic"
                    FontWeight="Bold"
                    Foreground="#FFE32636"
                    Text="1000  "
                    TextTrimming="None"
                    TextWrapping="NoWrap" />
            </StackPanel>
        </Grid>

        <StackPanel
            Margin="0,0,16,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Spacing="0">
            <TextBlock
                HorizontalAlignment="Right"
                FontSize="13"
                FontStyle="Italic"
                FontWeight="Bold"
                Foreground="#FFFFFFFF"
                CharacterSpacing="30"
                Text="GREATEST RACE" />
            <TextBlock
                Margin="0,2,0,0"
                HorizontalAlignment="Right"
                FontSize="18"
                FontStyle="Italic"
                FontWeight="Bold"
                Foreground="#FFE32636"
                CharacterSpacing="40"
                Text="ON EARTH" />
        </StackPanel>

        <Border
            Height="2"
            VerticalAlignment="Bottom"
            Background="#FFE32636"
            IsHitTestVisible="False" />
    </Grid>
</UserControl>
