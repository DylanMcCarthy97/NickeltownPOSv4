<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="NickeltownPOSV4.Controls.BathurstTabsHeader"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Height="88"
    MinHeight="88"
    MaxHeight="88">

    <!-- Full-width Race Day banner: continuous photo + live left title / right slogan. -->
    <Grid Background="#FF101216">
        <Image
            HorizontalAlignment="Stretch"
            VerticalAlignment="Center"
            Height="88"
            IsHitTestVisible="False"
            Stretch="UniformToFill">
            <Image.Source>
                <BitmapImage
                    DecodePixelHeight="88"
                    DecodePixelWidth="1024"
                    UriSource="ms-appx:///Assets/Bathurst/BathurstBanner1024x88.png" />
            </Image.Source>
        </Image>

        <!-- Soft left chequered accent; title stays live XAML over the dark flag zone. -->
        <Image
            Width="56"
            Height="88"
            HorizontalAlignment="Left"
            IsHitTestVisible="False"
            Opacity="0.42"
            Stretch="Fill">
            <Image.Source>
                <BitmapImage UriSource="ms-appx:///Assets/Bathurst/chequered-edge.png" />
            </Image.Source>
        </Image>

        <!-- Left ~40%: stacked italic BATHURST / red 1000 -->
        <StackPanel
            Margin="28,0,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            Spacing="-4">
            <TextBlock
                FontSize="28"
                FontStyle="Italic"
                FontWeight="Bold"
                Foreground="#FFFFFFFF"
                CharacterSpacing="-20"
                Text="BATHURST" />
            <TextBlock
                Margin="2,-6,0,0"
                FontSize="40"
                FontStyle="Italic"
                FontWeight="Bold"
                Foreground="#FFE32636"
                CharacterSpacing="-40"
                Text="1000" />
        </StackPanel>

        <!-- Right ~25%: slogan over Mount Panorama scenery -->
        <StackPanel
            Margin="0,0,18,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Spacing="-2">
            <TextBlock
                HorizontalAlignment="Right"
                FontSize="13"
                FontStyle="Italic"
                FontWeight="Bold"
                Foreground="#FFFFFFFF"
                CharacterSpacing="40"
                Text="GREATEST RACE" />
            <TextBlock
                HorizontalAlignment="Right"
                FontSize="18"
                FontStyle="Italic"
                FontWeight="Bold"
                Foreground="#FFE32636"
                CharacterSpacing="60"
                Text="ON EARTH" />
        </StackPanel>

        <Border
            Height="2"
            VerticalAlignment="Bottom"
            Background="#FFE32636"
            IsHitTestVisible="False" />
    </Grid>
</UserControl>
