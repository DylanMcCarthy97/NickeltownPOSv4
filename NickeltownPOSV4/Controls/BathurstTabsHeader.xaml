<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="NickeltownPOSV4.Controls.BathurstTabsHeader"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Height="88"
    MinHeight="88"
    MaxHeight="88">

    <!-- Full-width Race Day banner: artwork + live typography (no theme toggle column). -->
    <Grid Background="#FF101216">
        <Image
            HorizontalAlignment="Stretch"
            VerticalAlignment="Center"
            Height="88"
            IsHitTestVisible="False"
            Stretch="UniformToFill">
            <Image.Source>
                <BitmapImage
                    DecodePixelHeight="88"
                    DecodePixelWidth="1024"
                    UriSource="ms-appx:///Assets/Bathurst/BathurstBanner1024x88.png" />
            </Image.Source>
        </Image>

        <Image
            Width="48"
            Height="88"
            HorizontalAlignment="Left"
            IsHitTestVisible="False"
            Opacity="0.55"
            Stretch="Fill">
            <Image.Source>
                <BitmapImage UriSource="ms-appx:///Assets/Bathurst/chequered-edge.png" />
            </Image.Source>
        </Image>
        <Image
            Width="48"
            Height="88"
            HorizontalAlignment="Right"
            IsHitTestVisible="False"
            Opacity="0.55"
            Stretch="Fill">
            <Image.Source>
                <BitmapImage UriSource="ms-appx:///Assets/Bathurst/chequered-edge-right.png" />
            </Image.Source>
        </Image>

        <StackPanel
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="0">
            <TextBlock
                HorizontalAlignment="Center"
                FontSize="10"
                FontWeight="SemiBold"
                Foreground="#FFF5F5F5"
                Opacity="0.92"
                Text="NICKELTOWN POS" />
            <StackPanel
                HorizontalAlignment="Center"
                Orientation="Horizontal"
                Spacing="10">
                <TextBlock
                    FontSize="34"
                    FontStyle="Italic"
                    FontWeight="Bold"
                    Foreground="#FFFFFFFF"
                    Text="BATHURST" />
                <TextBlock
                    FontSize="34"
                    FontStyle="Italic"
                    FontWeight="Bold"
                    Foreground="#FFE32636"
                    Text="1000" />
            </StackPanel>
        </StackPanel>

        <Border
            Height="2"
            VerticalAlignment="Bottom"
            Background="#FFE32636"
            IsHitTestVisible="False" />
    </Grid>
</UserControl>
